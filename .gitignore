# .NET / build
bin/
obj/
*.user
*.suo
*.csproj.user

# Dados do launcher (contém a chave de API do SteamGridDB em config.json).
# _launcher/ é o nome antigo da pasta, de antes de o projeto virar "Mochila";
# _mochila/ é o de hoje. Os dois ficam de fora: quem clona o repositório não pode
# receber a minha biblioteca, as minhas capas nem a minha chave junto.
_launcher/
_mochila/

# Sandboxes de teste e de demonstração, criadas ao lado do exe e apagadas no fim.
# Ficam aqui para o caso de uma delas sobreviver a um teste interrompido.
_autoteste*/
_demo-tmp/

# Artefatos de release. O binario e anexado a release do GitHub, nao versionado
# aqui: repositorio guarda fonte, release guarda o exe.
dist/

# Segredos
.env
.env.*
secrets.json

# IDE
.vs/
.idea/
*.iml

# Sistema
Thumbs.db
.DS_Store

# Temporários
*.tmp
*.log

# Anotações de planejamento e rascunhos pessoais: ficam só na máquina.
ESPEC*.md
ESPEC*.pdf
teste.txt
